# Copy to server/.env and adjust. server/.env is never committed.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://app:app@localhost:5433/interview_prep
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string-000000
# Used only by `npm run db:seed-admin -w @app/server`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
